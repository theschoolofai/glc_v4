# Copy to .env and replace only the providers you use. Never commit .env.
GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=replace-me

# Logical provider order. Numbered Gemini slots are expanded automatically.
LLM_ORDER=ollama,ollama_edge,gemini,nvidia,groq,cerebras,openrouter,github
GLC_PORT=8111

# Optional second local Ollama daemon. Used when a machine has no cloud keys
# but still needs a ladder whose rungs are not all one provider's menu.
# OLLAMA_EDGE_MODEL=qwen2.5:7b
# OLLAMA_EDGE_URL=http://127.0.0.1:11435
